<?xml version="1.0" encoding="utf-8"?>
<!--
    Nothing leaves the device: not to cloud backup, not via device-to-device transfer.
    The session token is bound to this device's Keystore key (it can't be decrypted
    elsewhere), and the app repopulates everything else from the server after sign-in.
    android:allowBackup="false" alone doesn't stop D2D transfer on API 31+.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
