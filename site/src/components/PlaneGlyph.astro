---
// The Inboxies paper plane in the text colour, as a stroked line drawing (the
// geometry from scripts/generate-logo-assets.mjs). The viewBox is cropped to the
// mark so it fills its size.
//   variant="small" (default): 32-unit grid with heavier strokes and fewer folds,
//     for anything drawn at 32 px or below (header, footer, small tiles).
//   variant="full": the 512-unit master with every fold, for larger sizes.
interface Props {
	class?: string;
	variant?: "small" | "full";
}

const { class: className, variant = "small", ...rest } = Astro.props;
const small = variant === "small";
---

{
	small ? (
		<svg
			class:list={["plane-glyph", className]}
			viewBox="3.5 4 24 24"
			fill="none"
			stroke="currentColor"
			stroke-width="2"
			stroke-linejoin="round"
			stroke-linecap="round"
			aria-hidden="true"
			focusable="false"
			{...rest}
		>
			<path d="M26 6 L5 14 L9 18 L11 26 L15 23 L19 26 Z" />
			<path d="M26 6 L13 20 L11 26" />
			<path d="M13 20 L17 24 L15 23 L11 26 Z" fill="currentColor" />
		</svg>
	) : (
		<svg
			class:list={["plane-glyph", className]}
			viewBox="96 96 320 320"
			fill="none"
			stroke="currentColor"
			stroke-width="10"
			stroke-linejoin="round"
			stroke-linecap="round"
			aria-hidden="true"
			focusable="false"
			{...rest}
		>
			<path d="M406 114 L106 224 L158 284 L182 396 L232 354 L294 398 Z" />
			<path d="M106 224 L248 228 L406 114 M406 114 L206 316 L182 396 M406 114 L274 254 L294 398" />
			<path d="M206 316 L270 364 L266 377 L232 354 L182 396 Z" fill="currentColor" />
		</svg>
	)
}

<style>
	.plane-glyph {
		display: block;
	}
</style>
