{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "site",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--filter",
        "inboxies-site",
        "dev",
        "--port",
        "4321",
        "--ignore-lock"
      ],
      "port": 4321
    },
    {
      "name": "site-preview",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--filter",
        "inboxies-site",
        "preview",
        "--port",
        "8787"
      ],
      "port": 8787
    },
    {
      "name": "app",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "dev",
        "--port",
        "5173",
        "--strictPort"
      ],
      "port": 5173
    }
  ]
}
