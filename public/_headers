# Workers static assets: Apple fetches this to tie the iOS app (passkeys,
# `webcredentials:inboxies.app`) to the web app's domain. It has no file
# extension, so say it's JSON.
/.well-known/apple-app-site-association
  Content-Type: application/json

# Google fetches this to tie the Android app (Credential Manager passkeys,
# `delegate_permission/common.get_login_creds`) to the web app's domain.
# Say it's JSON explicitly.
/.well-known/assetlinks.json
  Content-Type: application/json

# Static assets (JS, CSS, images) are served before the Worker runs, so they
# don't get workers/lib/security-headers.ts. The baseline that applies to them
# (AVE-115); the Worker adds the rest to its own responses.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Strict-Transport-Security: max-age=31536000; includeSubDomains
